PORT=3000
NODE_ENV=development

# Comma-separated allowed origins for CORS
CLIENT_URL=http://localhost:5173,https://www.vidyank.com,https://vidyank.com

MONGODB_URI=
JWT_SECRET=

# Fast2SMS — OTP SMS delivery
# Prefer Smart OTP template ID from Fast2SMS panel (OTP SMS → Get Code).
# If FAST2SMS_OTP_ID is empty, Quick SMS route is used with a generated OTP.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
FAST2SMS_OTP_LENGTH=6
FAST2SMS_OTP_EXPIRY_MINUTES=10
# otp  = Fast2SMS OTP route (~₹0.25/SMS; requires website verification in Fast2SMS)
# q    = Quick SMS with custom Vidyank text (~₹5/SMS)
# auto = try otp, fall back to q
FAST2SMS_ROUTE=auto
# Test number that always accepts a fixed OTP without sending SMS (e.g. Play Store review).
# Leave empty to disable.
TEST_OTP_PHONE=9988776655
TEST_OTP_CODE=123456

# Production cookie domain (shared between www + api subdomains)
# COOKIE_DOMAIN=.vidyank.com

# AWS / S3 / CloudFront
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=learningplatforn

# CloudFront base URL used to build public video/thumbnail URLs from stored keys
CDN_URL=https://cdn.vidyank.com
